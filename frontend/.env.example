# Supabase — find these at:
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key (server-only — NEVER prefix with NEXT_PUBLIC_).
# Required for: employee invites, badge+PIN portal login, and all
# /api/me/* employee routes. Same Supabase settings page as above,
# under "service_role".
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Secret used to sign badge+PIN portal session cookies.
# Generate one with: openssl rand -hex 32
PORTAL_SESSION_SECRET=generate-a-long-random-string
